+- (void)showAnimatedCursor:(enum text_cursor_kinds)type
+                   inRect:(NSRect)rect
+                forWindow:(struct window *)w
+{
+  int x, y, width, height;
+  window_box (w, TEXT_AREA, &x, &y, &width, &height);
+  NSRect clip = NSIntersectionRect (NSMakeRect (x, y, width, height),
+                                     [self bounds]);
+  struct buffer *buffer = XBUFFER (w->contents);
+  ptrdiff_t start = marker_position (w->start);
+  BOOL same = (cursorWindow == w->sequence_number && cursorBuffer == buffer
+               && NSEqualPoints (cursorClip.origin, clip.origin)
+               && NSWidth (cursorClip) == NSWidth (clip)
+               && NSEqualSizes (cursorViewSize, [self bounds].size)
+               && cursorStart == start && cursorHscroll == w->hscroll
+               && cursorVscroll == w->vscroll);
+  /* Growing or shrinking the echo area only changes the bottom clip
+     edge.  Preserve motion if the text origin, width and view size are
+     unchanged; actual scrolling and frame resizing still reset it.  */
+  BOOL editing = same && cursorModiff != BUF_CHARS_MODIFF (buffer);
+  NSPoint old = [animatedCursor position];
+  /* A wrap caused by typing is a new layout, not a trip across the line.  */
+  if (editing && old.y != NSMinY (rect))
+    same = NO;
+
+  /* Horizontal motion only needs a strip of text.  Vertical motion can
+     retain velocity across reversals, so cover the full text area until
+     all of its springs have settled.  Keep coordinates fixed even when
+     the strip changes size or the echo area changes the bottom clip.  */
+  CFTimeInterval now = CACurrentMediaTime ();
+  NSRect textRect = NSMakeRect (NSMinX (clip), NSMinY (rect),
+                                NSWidth (clip), NSHeight (rect));
+  if (same)
+    {
+      if (old.y != NSMinY (rect))
+        textRect = clip;
+      else
+        textRect = NSUnionRect (textRect,
+          NSMakeRect (NSMinX (clip), old.y, NSWidth (clip),
+                       NSHeight ([animatedCursor bounds])));
+      if (now < cursorAnimationEnd)
+        textRect = NSUnionRect (textRect, cursorTextRect);
+    }
+  textRect = NSIntersectionRect (NSIntegralRect (textRect), clip);
+  CGImageRef text = type == FILLED_BOX_CURSOR
+    ? ns_cursor_text_image (self, w, textRect) : NULL;
+
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  if (!cursorClipLayer)
+    {
+      cursorClipLayer = [[CALayer alloc] init];
+      [cursorClipLayer setAnchorPoint:CGPointZero];
+      [cursorClipLayer setMasksToBounds:YES];
+      [[self layer] addSublayer:cursorClipLayer];
+      animatedCursor = [[CALayer alloc] init];
+      [animatedCursor setAnchorPoint:CGPointZero];
+      [cursorClipLayer addSublayer:animatedCursor];
+      cursorTextLayer = [[CALayer alloc] init];
+      [cursorTextLayer setAnchorPoint:CGPointZero];
+      [cursorClipLayer addSublayer:cursorTextLayer];
+      cursorTextMask = [[CALayer alloc] init];
+      [cursorTextMask setAnchorPoint:CGPointZero];
+      [cursorTextMask setBackgroundColor:[[NSColor blackColor] CGColor]];
+      [cursorTextLayer setMask:cursorTextMask];
+    }
+  /* View coordinates are top-down.  The backing layer's geometry is
+     owned by AppKit, so explicitly convert the clipping layer's origin.  */
+  NSPoint origin = clip.origin;
+  [cursorClipLayer setGeometryFlipped:![[self layer] isGeometryFlipped]];
+  if (![[self layer] isGeometryFlipped])
+    origin.y = NSHeight ([self bounds]) - NSMaxY (clip);
+  [cursorClipLayer setPosition:origin];
+  [cursorClipLayer setBounds:clip];
+  [cursorClipLayer setHidden:NO];
+  [animatedCursor setContentsScale:[[self window] backingScaleFactor]];
+  /* The solid shape and the text mask move together; the glyph image
+     stays fixed in window coordinates, including between retargets.  */
+  NSColor *color = [FRAME_CURSOR_COLOR (emacsframe)
+                     colorUsingColorSpace:[NSColorSpace sRGBColorSpace]];
+  [animatedCursor setBackgroundColor:(type == HOLLOW_BOX_CURSOR
+                                      ? NULL : [color CGColor])];
+  [animatedCursor setBorderColor:[color CGColor]];
+  [animatedCursor setBorderWidth:type == HOLLOW_BOX_CURSOR ? 1.0 : 0.0];
+  [animatedCursor setOpacity:1.0];
+  [animatedCursor setBounds:NSMakeRect (0, 0, NSWidth (rect), NSHeight (rect))];
+  [animatedCursor setPosition:rect.origin];
+  [cursorTextLayer setContentsScale:[[self window] backingScaleFactor]];
+  [cursorTextLayer setPosition:textRect.origin];
+  [cursorTextLayer setBounds:textRect];
+  [cursorTextLayer setContents:(id)text];
+  [cursorTextLayer setHidden:!text];
+  [cursorTextMask setBounds:[animatedCursor bounds]];
+  [cursorTextMask setContentsScale:[[self window] backingScaleFactor]];
+  [cursorTextMask setPosition:rect.origin];
+  if (text)
+    CGImageRelease (text);
+
+  Lisp_Object value = Fbuffer_local_value
+    (editing ? Qns_cursor_animation_typing_response : Qns_cursor_animation_response,
+     w->contents);
+  double response = NUMBERP (value) ? XFLOATINT (value) : 0;
+  if (!same || !isfinite (response) || response <= 0)
+    {
+      [animatedCursor removeAllAnimations];
+      [cursorTextMask removeAllAnimations];
+      cursorAnimationEnd = 0;
+    }
+  else if (!NSEqualPoints (old, rect.origin))
+    {
+      /* Bound the work retained by Core Animation for unusual settings.  */
+      response = MIN (2.0, MAX (0.01, response));
+      CASpringAnimation *spring = [CASpringAnimation animationWithKeyPath:@"position"];
+      double omega = 2 * M_PI / response;
+      [spring setMass:1];
+      [spring setStiffness:omega * omega];
+      [spring setDamping:2 * omega];
+      [spring setInitialVelocity:0];
+      [spring setAdditive:YES];
+      [spring setFromValue:[NSValue valueWithPoint:
+                                      NSMakePoint (old.x - NSMinX (rect),
+                                                   old.y - NSMinY (rect))]];
+      [spring setToValue:[NSValue valueWithPoint:NSZeroPoint]];
+      [spring setDuration:[spring settlingDuration]];
+      /* A nil key adds a new offset without replacing a running spring.  */
+      [animatedCursor addAnimation:spring forKey:nil];
+      [cursorTextMask addAnimation:spring forKey:nil];
+      cursorAnimationEnd = MAX (cursorAnimationEnd, now + [spring duration]);
+    }
+  [CATransaction commit];
+
+  cursorWindow = w->sequence_number;
+  cursorBuffer = buffer;
+  cursorModiff = BUF_CHARS_MODIFF (buffer);
+  cursorStart = start;
+  cursorHscroll = w->hscroll;
+  cursorVscroll = w->vscroll;
+  cursorClip = clip;
+  cursorViewSize = [self bounds].size;
+  cursorTextRect = textRect;
+}
