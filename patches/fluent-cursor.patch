diff --git a/lisp/term/ns-win.el b/lisp/term/ns-win.el
index f78e75b7..26254a03 100644
--- a/lisp/term/ns-win.el
+++ b/lisp/term/ns-win.el
@@ -56,6 +56,46 @@ ns
   "GNUstep/macOS specific features."
   :group 'environment)
 
+(defun ns--set-cursor-animation-option (symbol value)
+  "Set cursor animation option SYMBOL to VALUE and refresh the display."
+  (set-default symbol value)
+  (when (eq window-system 'ns)
+    (redraw-display)))
+
+(defcustom ns-cursor-animation nil
+  "Animate the active text cursor with a spring on macOS 10.14 or later.
+Point and editing take effect immediately.  All cursor shapes are supported.
+Filled boxes use native cursor colors and reveal stationary text through
+a moving mask.
+Use `setq-local' to override this setting in a particular buffer, for
+example from `term-mode-hook' or `compilation-mode-hook'.  Buffers without
+an override use the global default set through Customize or `setq-default'.
+The macOS Reduce Motion setting disables animation."
+  :type 'boolean
+  :group 'ns
+  :initialize #'custom-initialize-default
+  :set #'ns--set-cursor-animation-option)
+
+(defcustom ns-cursor-animation-response 0.125
+  "Spring response in seconds for cursor navigation.
+Smaller values settle faster.  This is the spring period, rather than the
+total settling time.  Positive values are limited to 0.01 through 2 seconds.
+A non-positive or non-numeric value makes navigation instantaneous.
+This setting can be overridden with `setq-local' for a particular buffer."
+  :type 'number
+  :group 'ns
+  :initialize #'custom-initialize-default
+  :set #'ns--set-cursor-animation-option)
+
+(defcustom ns-cursor-animation-typing-response 0.125
+  "Spring response in seconds for cursor movement after text edits.
+See `ns-cursor-animation-response' for the meaning and range of values.
+This setting can be overridden with `setq-local' for a particular buffer."
+  :type 'number
+  :group 'ns
+  :initialize #'custom-initialize-default
+  :set #'ns--set-cursor-animation-option)
+
 ;;;; Command line argument handling.
 
 (defvar x-invocation-args)
