+/* Animation runs in the window server.  Each movement adds a spring
+   offset from the previous model position to zero.  Existing offsets
+   continue to settle, preserving position and velocity on rapid input.  */
+- (void)hideAnimatedCursor:(BOOL)reset
+{
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  [cursorClipLayer setHidden:YES];
+  if (reset)
+    {
+      [animatedCursor removeAllAnimations];
+      [cursorTextMask removeAllAnimations];
+      [cursorTextLayer setContents:nil];
+      cursorAnimationEnd = 0;
+      cursorWindow = 0;
+      cursorBuffer = NULL;
+    }
+  [CATransaction commit];
+}
+
+- (void)resetAnimatedCursorForWindow:(struct window *)w
+{
+  if (cursorWindow == w->sequence_number)
+    [self hideAnimatedCursor:YES];
+}
+
+- (void)checkAnimatedCursor
+{
+  if (!cursorWindow)
+    return;
+  struct window *w = ns_active_cursor_window (emacsframe);
+  if (!ns_cursor_animation_enabled (w) || cursorWindow != w->sequence_number
+      || cursorBuffer != XBUFFER (w->contents))
+    [self hideAnimatedCursor:YES];
+  else if (!w->phys_cursor_on_p || w->phys_cursor_type == NO_CURSOR)
+    /* A partial update (for example, an echo-area message after paren
+       highlighting) can finish while the text cursor is erased.  Hide
+       it, but keep the position and springs for the subsequent redraw.  */
+    [self hideAnimatedCursor:NO];
+}
+
+/* Draw text at its screen coordinates, in the native box-cursor colors.
+   Core Animation subsequently reveals this fixed image through a moving
+   mask.  The frame's backing pixels and physical cursor remain untouched.  */
+static CGImageRef
+ns_cursor_text_image (EmacsView *view, struct window *w, NSRect rect)
+{
+  CGFloat scale = [[view window] backingScaleFactor];
+  size_t width = ceil (NSWidth (rect) * scale);
+  size_t height = ceil (NSHeight (rect) * scale);
+  if (!width || !height)
+    return NULL;
+  CGColorSpaceRef colors = [[[view window] colorSpace] CGColorSpace];
+  CGContextRef context = CGBitmapContextCreate
+    (NULL, width, height, 8, 0, colors,
+     kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Host);
+  if (!context)
+    return NULL;
+  CGContextTranslateCTM (context, 0, height);
+  CGContextScaleCTM (context, scale, -scale);
+  CGContextTranslateCTM (context, -NSMinX (rect), -NSMinY (rect));
+
+  block_input ();
+  [NSGraphicsContext saveGraphicsState];
+  BOOL saved = gsaved;
+  gsaved = NO;
+  ns_cursor_context = context;
+  [NSGraphicsContext setCurrentContext:
+    [NSGraphicsContext graphicsContextWithCGContext:context flipped:YES]];
+  [FRAME_CURSOR_COLOR (XFRAME (w->frame)) set];
+  NSRectFill (rect);
+  gui_draw_window_cursor_layer (w, floor (NSMinY (rect)), ceil (NSMaxY (rect)));
+  ns_cursor_context = NULL;
+  gsaved = saved;
+  [NSGraphicsContext restoreGraphicsState];
+  unblock_input ();
+
+  CGImageRef image = CGBitmapContextCreateImage (context);
+  CGContextRelease (context);
+  return image;
+}
