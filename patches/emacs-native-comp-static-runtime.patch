diff --git a/lisp/emacs-lisp/comp.el b/lisp/emacs-lisp/comp.el
--- a/lisp/emacs-lisp/comp.el
+++ b/lisp/emacs-lisp/comp.el
@@ -3317,4 +3317,14 @@ Prepare every function for final compilation and drive the C back-end."
   (let ((dir (file-name-directory name)))
+    ;; GCC records the build machine's SDK path.  Override it with the SDK
+    ;; selected on the machine running this Emacs so downloaded apps remain
+    ;; able to native-compile after Xcode moves or is upgraded.
+    (when (eq system-type 'darwin)
+      (let ((default-directory invocation-directory))
+        (setf (comp-ctxt-driver-options comp-ctxt)
+              (append (list "-isysroot"
+                            (car (process-lines "/usr/bin/xcrun" "--sdk"
+                                                "macosx" "--show-sdk-path")))
+                      (comp-ctxt-driver-options comp-ctxt)))))
     (comp--finalize-relocs)
     (maphash (lambda (_ f)
                (comp--log-func f 1))
diff --git a/src/comp.c b/src/comp.c
--- a/src/comp.c
+++ b/src/comp.c
@@ -4709,3 +4709,13 @@ add_driver_options (void)
 #if defined (LIBGCCJIT_HAVE_gcc_jit_context_add_driver_option)
   load_gccjit_if_necessary (true);
+#ifdef DARWIN_OS
+  /* The bundled libemutls_w archive is needed when libgccjit links an
+     .eln file.  Locate it relative to Emacs so an app remains relocatable.  */
+  Lisp_Object runtime_dir
+    = Fexpand_file_name (build_string ("../Frameworks/libgccjit"),
+                         Vinvocation_directory);
+  Lisp_Object runtime_option = concat2 (build_string ("-L"), runtime_dir);
+  gcc_jit_context_add_driver_option (comp.ctxt, SSDATA (runtime_option));
+  gcc_jit_context_add_driver_option (comp.ctxt, "-static-libgcc");
+#endif
   if (!NILP (Fcomp_native_driver_options_effective_p ()))
@@ -4816,4 +4826,7 @@ DEFUN ("comp--compile-ctxt-to-file0", Fcomp__compile_ctxt_to_file0,
-#endif
-
-  comp.speed = XFIXNUM (CALLNI (comp-ctxt-speed, Vcomp_ctxt));
+#else
+  gcc_jit_context_set_str_option (comp.ctxt, GCC_JIT_STR_OPTION_PROGNAME,
+                                  "libgccjit");
+#endif
+
+  comp.speed = XFIXNUM (CALLNI (comp-ctxt-speed, Vcomp_ctxt));
   eassert (comp.speed < INT_MAX);
